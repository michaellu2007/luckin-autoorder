# ===== 隐私与本地凭证：绝对不允许提交 =====
# 注意：gitignore 不支持行内注释，规则必须独占一行

# config.yaml：推送 key、门店（复旦叶耀珍楼）等个人信息
config.yaml

# token.yaml：瑞幸账号登录凭证
token.yaml

# endpoints.yaml：抓包产物
endpoints.yaml

# ratings.yaml：个人口味评分（想公开就删掉下面这行）
ratings.yaml

# logs/：运行日志、订单号、取餐码、抓包记录
logs/

capture.jsonl
*.flow
__pycache__/
*.pyc
